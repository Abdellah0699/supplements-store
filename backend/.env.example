PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=<redacted>

# Where the customer frontend is served from, for CORS
# (the admin dashboard runs on the same origin in dev: http://localhost:5500/admin/)
FRONTEND_URL=http://localhost:5500

# --- Phase 4: admin authentication ---
# Secret used to sign admin session tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# How long an admin stays logged in, in seconds (43200 = 12 hours)
AUTH_TOKEN_TTL_SECONDS=43200

# Cookie SameSite mode for the admin session cookie:
#   lax  - admin frontend served from the same site as the API (default, incl. localhost dev)
#   none - admin frontend on a different site (requires HTTPS)
AUTH_COOKIE_SAMESITE=lax

# --- First admin account (only used by `npm run seed`) ---
# The password is hashed with bcrypt before it is stored and is never logged.
# It must be at least 8 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Product image storage (Supabase Storage, production) ---
# When both are set, product image uploads go to Supabase Storage
# (persistent) instead of local disk (ephemeral on free hosting).
# Find these in your Supabase project: Settings -> API.
# The bucket must be PUBLIC so the customer site can load the images
# (Supabase dashboard -> Storage -> New bucket -> check "Public bucket").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
